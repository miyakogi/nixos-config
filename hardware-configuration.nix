# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, pkgs, lib, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "ahci" "nvme" "usbhid" "usb_storage" "sd_mod" ];
  # boot.initrd.kernelModules = [ "amdgpu" ];
  boot.initrd.kernelModules = [
    "i915"
    "amdgpu"
    "btrfs"
  ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  # Vulkan
  # hardware.opengl.driSupport = true;
  hardware.graphics = {
    enable = true;
    enable32Bit = true;
    extraPackages = [
      pkgs.intel-media-driver
      pkgs.vpl-gpu-rt
    ];
  };

  fileSystems."/" =
    { device = "/dev/disk/by-uuid/c08a2aab-4b83-4a85-badb-c112d3228822";
      fsType = "btrfs";
      options = [ "subvol=@nixos" "rw" "noatime" "compress=zstd" ];
    };

  fileSystems."/home" =
    { device = "/dev/disk/by-uuid/c08a2aab-4b83-4a85-badb-c112d3228822";
      fsType = "btrfs";
      options = [ "subvol=@nixos-home" "rw" "noatime" "compress=zstd" ];
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/7D68-C268";
      fsType = "vfat";
    };

  fileSystems."/media/game" =
    { device = "/dev/disk/by-uuid/4d7e6234-c1aa-4c7b-b57a-288c7a36e94f";
      fsType = "btrfs";
      options = [ "subvol=@game" "rw" "noatime" "compress=zstd" ];
    };

  fileSystems."/media/arch-root" =
    { device = "/dev/disk/by-uuid/c08a2aab-4b83-4a85-badb-c112d3228822";
      fsType = "btrfs";
      options = [ "subvol=@" "rw" "noatime" "compress=zstd" ];
    };

  fileSystems."/media/arch-root/.snapshots" =
    { device = "/dev/disk/by-uuid/c08a2aab-4b83-4a85-badb-c112d3228822";
      fsType = "btrfs";
      options = [ "subvol=@snapshots" "rw" "noatime" "compress=zstd" ];
    };

  fileSystems."/media/arch-home" =
    { device = "/dev/disk/by-uuid/c08a2aab-4b83-4a85-badb-c112d3228822";
      fsType = "btrfs";
      options = [ "subvol=@home" "rw" "noatime" "compress=zstd" ];
    };

  fileSystems."/media/arch-home/.snapshots" =
    { device = "/dev/disk/by-uuid/c08a2aab-4b83-4a85-badb-c112d3228822";
      fsType = "btrfs";
      options = [ "subvol=@snapshots-home" "rw" "noatime" "compress=zstd" ];
    };

  fileSystems."/swap" =
    { device = "/dev/disk/by-uuid/c08a2aab-4b83-4a85-badb-c112d3228822";
      fsType = "btrfs";
      options = [ "subvol=@swap" "noatime" ];
    };

  swapDevices = [ 
    {
      device = "/swap/swapfile";
    }
  ];

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp8s0.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
