+void MozcState::PruneDelayedCommands() {
+  for (auto it = delayed_commands_.begin(); it != delayed_commands_.end();) {
+    // A fired time event disables itself before returning. Drop it outside of
+    // its callback so the event loop never observes a destroyed source.
+    if (!(*it)->isEnabled()) {
+      it = delayed_commands_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void MozcState::CancelDelayedCommands() { delayed_commands_.clear(); }
+
+void MozcState::ScheduleDelayedCommand(
+    const mozc::commands::SessionCommand& command, uint32_t delay_millisec) {
+  if (delay_millisec == 0) {
+    return;
+  }
+
+  PruneDelayedCommands();
+
+  // Copy the whole command. Mozkey attaches a live conversion generation and
+  // key to the callback so that the server can reject stale requests.
+  const uint64_t delay_usec = static_cast<uint64_t>(delay_millisec) * 1000;
+  auto event = engine_->instance()->eventLoop().addTimeEvent(
+      CLOCK_MONOTONIC, now(CLOCK_MONOTONIC) + delay_usec, 0,
+      [this, command](EventSourceTime* source, uint64_t) {
+        source->setEnabled(false);
+        mozc::commands::Output output;
+        if (!SendCommand(command, &output)) {
+          LOG(ERROR) << "Delayed session command failed";
+          return false;
+        }
+        // The response may itself request another delayed command.
+        ParseResponse(output);
+        return false;
+      });
+  delayed_commands_.push_back(std::move(event));
+}
