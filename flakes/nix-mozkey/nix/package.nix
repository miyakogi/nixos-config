{
  lib,
  stdenv,
  runCommand,
  applyPatches,
  bazel_9,
  pkg-config,
  python3,
  gettext,
  unzip,
  writableTmpDirAsHomeHook,
  qt6,
  libglvnd,
  fcitx5,
  ibus,
  glib,
  xdg-utils,
  powershell,
  git,
  bzip2,
  cacert,
  coreutils,
  mozkey-src,
  fcitx-mozc-src,
  version,
}:

# The Bazel offline-vendoring logic below mirrors pkgs/by-name/mo/mozc in
# nixpkgs (BSD-3-Clause). It is inlined so that this flake does not depend on
# nixpkgs internals of the mozc package.

let
  bazel = bazel_9;
  pname = "fcitx5-mozkey";

  # fcitx/mozc's fcitx5 engine ignores the delayed callbacks the server sends,
  # which leaves Mozkey's debounced live conversion inactive. The patch adds a
  # client-side scheduler for them.
  fcitx5EngineSrc = applyPatches {
    name = "fcitx-mozc-src-patched";
    src = fcitx-mozc-src;
    patches = [ ./patches/fcitx5-live-conversion.patch ];
  };

  buildInputs = [
    libglvnd
    qt6.qtbase
    fcitx5
  ];

  includePath = lib.makeIncludePath buildInputs;
  libraryPath = lib.makeLibraryPath buildInputs;

  bazelCommonArgs = [
    "--config=oss_linux"
    "--config=stable_channel"
    "--config=release_build"
    # Build protoc from source instead of downloading a host-platform binary.
    "--@com_google_protobuf//bazel/flags:prefer_prebuilt_protoc=false"
  ];

  bazelArgs = bazelCommonArgs ++ [
    "--action_env=C_INCLUDE_PATH=${includePath}"
    "--action_env=CPLUS_INCLUDE_PATH=${includePath}"
    "--action_env=LIBRARY_PATH=${libraryPath}"
    "--repo_env=PKG_CONFIG_PATH"
    "unix/fcitx5:fcitx5-mozc.so"
    "//gui/tool:mozc_tool"
    "//server:mozc_server"
  ];

  bazelPythonConfig = ''
    local_runtime_repo = use_repo_rule(
        "@rules_python//python/local_toolchains:repos.bzl",
        "local_runtime_repo",
    )
    local_runtime_toolchains_repo = use_repo_rule(
        "@rules_python//python/local_toolchains:repos.bzl",
        "local_runtime_toolchains_repo",
    )

    local_runtime_repo(
        name = "local_python3",
        interpreter_path = "python3",
        on_failure = "fail",
    )

    local_runtime_toolchains_repo(
        name = "local_toolchains",
        runtimes = ["local_python3"],
    )

    register_toolchains("@local_toolchains//:all")
  '';

  setupBazelVendor = vendorDeps: ''
    cat >> MODULE.bazel << EOF
    ${bazelPythonConfig}
    EOF

    cp -r "${vendorDeps}"/* .
    chmod -R u+w vendor_dir
    # The local runtime otherwise generates scripts with /usr/bin/env shebangs.
    substituteInPlace vendor_dir/rules_python*/python/private/local_runtime_repo_setup.bzl \
      --replace-fail 'interpreter_path = interpreter_path,' \
        'interpreter_path = interpreter_path, stub_shebang = "#!${lib.getExe python3}",'
    patchShebangs --build vendor_dir
    for dir in vendor_dir/*/; do
      echo "pin(\"@@$(basename "$dir")\")"
    done > vendor_dir/VENDOR.bazel
  '';

  # The daily Mozkey dictionary is generated by the upstream PowerShell
  # pipeline (Wikipedia index, UT dictionaries, nico/pixiv, personal names).
  # Every network input is pinned by tools/dictionary/locks/daily_sources.json,
  # so the fixed-output hash is reproducible.
  dictionary = stdenv.mkDerivation {
    pname = "${pname}-daily-dictionary";
    inherit version;
    src = mozkey-src;

    nativeBuildInputs = [
      powershell
      python3
      git
      bzip2
      cacert
      coreutils
    ];

    strictDeps = true;
    __structuredAttrs = true;
    dontFixup = true;

    outputHashMode = "recursive";
    outputHashAlgo = "sha256";
    outputHash = "sha256-zf3tKrQzNJPytW/Y96T+9NIUD99HWpHWnfh6Hn1o4SE=";

    buildPhase = ''
      runHook preBuild
      export HOME=$TMPDIR/home
      mkdir -p "$HOME"
      export SSL_CERT_FILE=${cacert}/etc/ssl/certs/ca-bundle.crt
      export GIT_SSL_CAINFO=$SSL_CERT_FILE
      pwsh -NoProfile -File tools/dictionary/prepare_daily_dictionary.ps1
      runHook postBuild
    '';

    installPhase = ''
      runHook preInstall
      install -d "$out"
      for name in \
        dic-nico-pixiv-delta \
        koyasi-syntax-guard \
        mozcdic-ut-daily \
        mozcdic-ut-personal-names-daily
      do
        install -Dm644 "src/data/dictionary_koyasi/generated/profiled/$name.txt" "$out/$name.txt"
      done
      runHook postInstall
    '';
  };

  # Mozkey with the fcitx5 engine added, the daily dictionary installed and
  # the Qt 6.12 uic incompatibility fixed.
  preparedSrc = runCommand "mozkey-${version}-patched-src" { } ''
    cp -a ${mozkey-src} $out
    chmod -R u+w $out

    cp -a ${fcitx5EngineSrc}/src/unix/fcitx5 $out/src/unix/fcitx5

    cat >> $out/src/MODULE.bazel <<'EOF'

    # Added by the nix-mozkey flake.
    pkg_config_repository(
        name = "fcitx5",
        packages = [
            "Fcitx5Core",
            "Fcitx5Module",
        ],
    )
    EOF

    # Qt 6.12 uic rejects custom widget class names starting with "::".
    sed -i 's/::mozc::gui::DictionaryContentTableWidget/mozc::gui::DictionaryContentTableWidget/g' \
      $out/src/gui/dictionary_tool/dictionary_tool.ui

    # The flake always ships the full daily dictionary profile.
    sed -i -E \
      's#//data/dictionary_koyasi:mozcdic_ut_(sample|daily_local|rich_local|max_local)#//data/dictionary_koyasi:mozcdic_ut_daily_local#g' \
      $out/src/data/dictionary_oss/BUILD.bazel

    install -d $out/src/data/dictionary_koyasi/generated/profiled
    install -m644 ${dictionary}/*.txt $out/src/data/dictionary_koyasi/generated/profiled/
  '';

  vendorDeps = stdenv.mkDerivation (
    lib.fetchers.normalizeHash { } {
      pname = "${pname}-vendor";
      inherit version;
      src = preparedSrc;

      outputHashMode = "recursive";
      outputHash = "sha256-goWO0U2bXoXzVdkdOqAhFmlOxfWagf8PWujc2CzZUf0=";

      strictDeps = true;
      __structuredAttrs = true;

      env.USE_BAZEL_VERSION = bazel.version;
      # Work around Bazel's username lookup with sandbox=false and
      # auto-allocate-uids=true.
      env.USER = "nixbld";

      nativeBuildInputs = [
        bazel
        pkg-config
        python3
        unzip
        writableTmpDirAsHomeHook
      ];

      buildInputs = buildInputs ++ [
        glib
        ibus
      ];

      buildPhase = ''
        runHook preBuild

        cd src

        cat >> MODULE.bazel << EOF
        ${bazelPythonConfig}
        EOF

        bazel vendor --lockfile_mode=update --vendor_dir="$out/vendor_dir" ${lib.escapeShellArgs bazelArgs}
        cp MODULE.bazel.lock "$out"

        echo "removing platform-specific repository metadata..."
        find "$out" -type l -lname '/*' -print -delete
        find "$out" -xtype l -print -delete
        find "$out/vendor_dir" -maxdepth 1 -type f -name '*.marker' -print -delete
        rm -vrf \
          "$out"/vendor_dir/*local_python3* \
          "$out"/vendor_dir/*go_sdk+go_toolchains*

        runHook postBuild
      '';

      dontInstall = true;
      dontFixup = true;
      dontWrapQtApps = true;
    }
  );
in
stdenv.mkDerivation {
  inherit
    pname
    version
    ;

  src = preparedSrc;

  strictDeps = true;
  __structuredAttrs = true;

  # mozc_tool is a Qt application, but it is installed under lib/mozkey and
  # launched by fcitx5 rather than from $out/bin, so the Qt wrapper hook has
  # nothing to wrap.
  dontWrapQtApps = true;

  env.USE_BAZEL_VERSION = bazel.version;
  env.USER = "nixbld";

  nativeBuildInputs = [
    bazel
    pkg-config
    python3
    gettext
    unzip
    writableTmpDirAsHomeHook
  ];

  inherit buildInputs;

  postPatch = ''
    cd src

    ${setupBazelVendor vendorDeps}

    substituteInPlace config.bzl \
      --replace-fail "/usr/bin/xdg-open" "${xdg-utils}/bin/xdg-open" \
      --replace-fail "/usr/lib/mozkey" "$out/lib/mozkey" \
      --replace-fail "/usr/share/icons/mozkey" "$out/share/icons"
  '';

  buildPhase = ''
    runHook preBuild

    # --action_env=HOME forwards the hook's HOME into Bazel actions with
    # sandbox=false and auto-allocate-uids=true.
    bazel build \
      --action_env=HOME \
      --lockfile_mode=error --vendor_dir=vendor_dir ${lib.escapeShellArgs bazelArgs}

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    install -Dm555 bazel-bin/server/mozc_server "$out/lib/mozkey/mozc_server"
    install -Dm555 bazel-bin/gui/tool/mozc_tool "$out/lib/mozkey/mozc_tool"
    install -Dm555 bazel-bin/unix/fcitx5/fcitx5-mozc.so "$out/lib/fcitx5/fcitx5-mozc.so"

    install -Dm444 ${fcitx5EngineSrc}/src/unix/fcitx5/mozc-addon.conf "$out/share/fcitx5/addon/mozc.conf"
    install -Dm444 ${fcitx5EngineSrc}/src/unix/fcitx5/mozc.conf "$out/share/fcitx5/inputmethod/mozc.conf"

    # Translations for the fcitx5 addon.
    for po in ${fcitx5EngineSrc}/src/unix/fcitx5/po/*.po; do
      lang=$(basename "$po" .po)
      ${gettext}/bin/msgfmt "$po" -o "fcitx5-mozc.mo"
      install -Dm644 "fcitx5-mozc.mo" "$out/share/locale/$lang/LC_MESSAGES/fcitx5-mozc.mo"
    done
    rm -f fcitx5-mozc.mo

    # Icons referenced by mozc.conf / mozc-addon.conf.
    icons="$out/share/icons/hicolor"
    install -Dm644 data/images/product_icon_32bpp-128.png \
      "$icons/128x128/apps/org.fcitx.Fcitx5.fcitx_mozc.png"
    install -Dm644 data/images/unix/ime_product_icon_opensource-32.png \
      "$icons/32x32/apps/org.fcitx.Fcitx5.fcitx_mozc.png"
    for icon in alpha_full alpha_half direct hiragana katakana_full katakana_half dictionary properties tool; do
      install -Dm644 "${fcitx5EngineSrc}/scripts/icons/ui-$icon.png" \
        "$icons/48x48/apps/org.fcitx.Fcitx5.fcitx_mozc_$icon.png"
    done
    ln -sf org.fcitx.Fcitx5.fcitx_mozc.png "$icons/128x128/apps/fcitx_mozc.png"
    ln -sf org.fcitx.Fcitx5.fcitx_mozc.png "$icons/32x32/apps/fcitx_mozc.png"
    for icon in alpha_full alpha_half direct hiragana katakana_full katakana_half dictionary properties tool; do
      ln -sf "org.fcitx.Fcitx5.fcitx_mozc_$icon.png" "$icons/48x48/apps/fcitx_mozc_$icon.png"
    done

    install -Dm444 ../LICENSE "$out/share/licenses/$pname/LICENSE"
    install -Dm444 ../THIRD_PARTY_NOTICES.md "$out/share/licenses/$pname/THIRD_PARTY_NOTICES.md"

    runHook postInstall
  '';

  passthru = {
    inherit dictionary vendorDeps;
    mozkeyVersion = version;
  };

  meta = {
    description = "Mozkey (Mozc fork) Japanese input method for fcitx5";
    homepage = "https://github.com/koyasi777/mozkey";
    license = lib.licenses.bsd3;
    platforms = lib.platforms.linux;
    maintainers = [ ];
  };
}
